PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret — đặt giá trị riêng, không dùng giá trị mẫu này trên cloud
AGENT_API_KEY=change-me

# Chạy bằng docker compose thì REDIS_URL được đặt sẵn là redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
